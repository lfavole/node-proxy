# ==============================================================================
# Node Proxy Configuration Environment Variables
# ==============================================================================

# PORT: Listening port for the reverse proxy gateway
PORT=3000

# DOMAIN: Primary apex domain used for subdomain routing (e.g., app.lfavole.fr)
DOMAIN=lfavole.fr

# DEFAULT_APP: Application served when accessing the naked root domain or direct IP
DEFAULT_APP=my-main-app

# STATUS_PASSWORD: Password protecting the /status dashboard and telemetry endpoints
# Leave empty to allow unauthenticated access to the status page.
STATUS_PASSWORD=admin

# APPS_DIR: Directory path containing the target application folders (defaults to parent folder '..')
APPS_DIR=..

# START_PORT: Port range base for assigning internal loopback ports to sub-processes
START_PORT=3001

# IDLE_TIMEOUT: Idle duration in milliseconds before stopping inactive apps (5 min = 300000)
IDLE_TIMEOUT=300000

# HEALTH_CHECK_INTERVAL: Interval in milliseconds for checking responsiveness of active apps
HEALTH_CHECK_INTERVAL=300000

# GRACE_PERIOD: Milliseconds to wait after SIGTERM before escalating to SIGKILL
GRACE_PERIOD=15000

# DOMAIN_MAPPINGS: Dedicated domain routing mapping external domains directly to application folders
# Supports either comma-separated pairs: example.com:node-app,api.otherdomain.org:python-app
# Or JSON object format: {"example.com":"node-app","api.otherdomain.org":"python-app"}
DOMAIN_MAPPINGS=example.com:node-app,my-portfolio.fr:static-app
